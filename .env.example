# 複製這個檔案成 .env,然後填入你的值
# 取得 api_id / api_hash:登入 https://my.telegram.org → API development tools

TG_API_ID=123456
TG_API_HASH=填入你的_api_hash

# 要抓的頻道:私人邀請連結 / @username / 數字 id 都可以
TG_CHANNEL=https://t.me/+3j-gRC37UBo0MjM1

# 初次回補的天數(第一次執行用;之後改成只抓新訊息)
INITIAL_DAYS=30

# 時區(用於「by 日」「by 週」分組)
TZ=Asia/Taipei


# ===================== AI 洞察(頁籤⑤,選用)=====================
# 沒有設金鑰也完全沒關係:make_insights.py 會直接略過,
# 網站少掉頁籤⑤,其餘四頁完全不受影響。
#
# 金鑰只存在這個本機檔案,永不進 git、不需要 GitHub Secret ——
# AI 步驟跑在本機每小時排程裡,雲端只負責發布產生好的靜態檔。

# Gemini(主力,免費):https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 模型可覆寫。預設 gemini-3.8-flash(主)+ gemini-3.5-flash-lite(降級備援)。
# 你的免費額度看這裡:https://aistudio.google.com/rate-limit
# 若主模型額度太緊,改成 lite 當主力即可:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
# 某些世代若不接受 thinkingConfig,設 -1 可完全不送該參數:
# GEMINI_THINKING_BUDGET=-1

# OpenRouter(免費的第二供應商備援,與 Google 完全獨立):https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 付費備援(Claude)。預設關閉:要同時設金鑰「且」把 AI_ALLOW_PAID 改成 1 才會啟用。
# 這道閘門讓失控迴圈也不可能產生帳單。
ANTHROPIC_API_KEY=
AI_ALLOW_PAID=0

# 節流:距上次執行未滿這麼多小時就略過(20 而非 24,確保每個日曆日都跑得到)
AI_MIN_INTERVAL_HOURS=20
# 單次執行最多產生幾個單元(最壞情況的硬上限)
AI_MAX_UNITS=12
# 敘事線候選標籤上限(想先試水溫可以調小,如 20)
STORY_MAX_TAGS=80
